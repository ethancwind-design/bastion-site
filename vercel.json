{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/portfolio",
      "destination": "/investments",
      "permanent": true
    },
    {
      "source": "/team",
      "destination": "/executive-board",
      "permanent": false
    },
    {
      "source": "/equities",
      "destination": "/what-we-do",
      "permanent": false
    },
    {
      "source": "/credit-convertibles",
      "destination": "/what-we-do",
      "permanent": false
    },
    {
      "source": "/quantitative-strategies",
      "destination": "/what-we-do",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/media/research/(.*)\\.pdf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/pdf"
        },
        {
          "key": "Content-Disposition",
          "value": "inline; filename=\"Bastion - TTWO Initiation.pdf\""
        }
      ]
    }
  ]
}
